# ResQAgent Environment Configuration

# Google Gemini API Key (Optional: system automatically falls back to deterministic cognitive engine if not provided)
AI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret Key
JWT_SECRET=resqagent-super-secret-jwt-key-32-chars-min-prod

# Initial System Administrator Credentials
INITIAL_ADMIN_EMAIL=admin@resqagent.org
INITIAL_ADMIN_PASSWORD=ResQAdmin2026!
INITIAL_ADMIN_NAME=System Administrator

# Database Connection (Defaults to SQLite for local development; supports PostgreSQL in production)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/resqagent
DATABASE_URL=sqlite:///./resqagent.db
