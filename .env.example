# ==============================================================================
# RESQAGENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT (Default)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./resqagent.db
JWT_SECRET=resqagent-super-secret-jwt-key-32-chars-min-prod
INITIAL_ADMIN_EMAIL=admin@resqagent.org
INITIAL_ADMIN_PASSWORD=ResQAdmin2026!
INITIAL_ADMIN_NAME=System Administrator
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8000
# AI_API_KEY=your_gemini_api_key_here  # Optional: falls back to deterministic cognitive engine

# ------------------------------------------------------------------------------
# 2. RENDER PRODUCTION (FastAPI Web Service)
# Configure these in Render Dashboard -> Service -> Environment
# ------------------------------------------------------------------------------
# PYTHON_VERSION=3.11.9
# DATABASE_URL=postgresql://postgres:your_password@dpg-xxx.render.com/resqagent  # Render PostgreSQL
# JWT_SECRET=generate_a_random_32_character_secret_here
# INITIAL_ADMIN_EMAIL=admin@resqagent.org
# INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere2026!
# INITIAL_ADMIN_NAME=System Administrator
# CORS_ORIGINS=https://your-custom-domain.com
# FRONTEND_URL=https://your-resqagent.vercel.app

# ------------------------------------------------------------------------------
# 3. VERCEL PRODUCTION (Frontend)
# Configure in vercel.json rewrites or window injection if calling cross-origin
# ------------------------------------------------------------------------------
# VITE_API_URL=https://resqagent-backend.onrender.com
# Vercel rewrites proxy all /api/* requests directly to your Render backend
